module Interrupt;


////* Fig. 8
global protocol Interrupt(role P, role Q) {
    mixed { // LHS
        Start() from P to Q;  // c
        choice at P {
            rec X {  // !!! XXX Fig. 8 wrong order
                More() from P to Q;  // a
                continue X;
            }
        } or {
            Stop() from P to Q;  // !!! Q*;  // Q commits  // d
            Ack() from Q to P;  // !!! Fixed -- cf. Ex 3.8
        }
    } or P->Q { // RHS
        Interrupt() from Q to P;
    }
}